# HOW TO USE THIS FILE
# Copy it to "web/.env.local" (same folder) and fill in the values from your Firebase project
# (Project settings > General > Your apps > Web app, and Cloud Messaging > Web Push certificates).
# These are PUBLIC web settings (they end up in the built app), but keep the file out of Git anyway.
# Leave them empty and push notifications are simply switched off in the app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
