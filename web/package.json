{
  "name": "precog-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-landing-data": "node scripts/build-landing-data.mjs",
    "check-landing-data": "node scripts/build-landing-data.mjs --check",
    "prebuild": "npm run build-landing-data",
    "build": "vite build",
    "preview": "vite preview --port 4173",
