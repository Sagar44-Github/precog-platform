    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "esbuild": "^0.21.5",
    "playwright": "1.64.1",
