{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/evaluation_request.schema.json",
  "title": "Precog evaluation parameters",
  "type": "object",
  "properties": {
    "seed": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
    "test_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.5},
    "alpha_grid": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "number", "minimum": 0.001, "maximum": 2}}
  },
  "additionalProperties": false
}
