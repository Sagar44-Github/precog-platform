{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/containment_action.schema.json",
  "title": "Containment action",
  "description": "A simulated containment, proposed first and executed only after confirmation.",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "target_host": {
      "type": "string",
      "minLength": 1
    },
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "operation": {
      "type": "string",
      "enum": ["contain", "release"]
    },
    "playbook": {
      "type": ["string", "null"],
      "enum": ["host", "zone", "predicted_path", "top_three", "release", null]
    },
    "related_action_id": {
      "type": ["string", "null"]
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "previous_states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host_id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["normal", "compromised"] }
        },
        "required": ["host_id", "state"],
        "additionalProperties": false
      }
    },
    "forecast_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "console",
        "mobile"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_confirmation",
        "executed",
        "cancelled",
        "expired"
      ]
    },
    "proposed_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 UTC time, for example 2026-10-03T10:00:03Z"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 UTC time or null"
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action_id",
    "target_host",
    "forecast_id",
    "requested_by",
    "status",
    "proposed_at",
    "confirmed_at",
    "result"
  ],
  "additionalProperties": false
}
