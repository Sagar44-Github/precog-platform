{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/upload_job.schema.json",
  "title": "Dataset upload job",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "sniffing",
        "building",
        "preview",
        "installed",
        "failed",
        "cancelled"
      ]
    },
    "bytes_received": {
      "type": "integer",
      "minimum": 0
    },
    "size_limit": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000
    }
  },
  "required": [
    "job_id",
    "filename",
    "state",
    "bytes_received",
    "size_limit",
    "message"
  ],
  "additionalProperties": false
}
