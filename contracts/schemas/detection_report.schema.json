{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/detection_report.schema.json",
  "title": "Detection report",
  "description": "Static offline CICIDS2017 evaluation results.",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "precision": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "f1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "false_positive_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "model",
    "dataset",
    "split",
    "precision",
    "recall",
    "f1",
    "false_positive_rate",
    "notes"
  ],
  "additionalProperties": false
}
