{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/topology_summary.schema.json",
  "title": "Paged topology summary",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total_hosts": {
      "type": "integer",
      "minimum": 0
    },
    "has_more": {
      "type": "boolean"
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "criticality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "host_id",
          "name",
          "zone",
          "role",
          "criticality"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "dst": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "feasible",
              "observed"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "src",
          "dst",
          "kind",
          "count"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "workspace_id",
    "version",
    "offset",
    "total_hosts",
    "has_more",
    "hosts",
    "edges"
  ],
  "additionalProperties": false
}
