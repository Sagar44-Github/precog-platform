{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/topology_summary.schema.json",
  "title": "Paged and aggregated network topology summary",
  "type": "object",
  "required": ["items", "total_hosts", "total_edges", "total_matches", "offset", "limit", "next_offset", "query", "zone", "zones", "edge_bundles", "page_edges", "page_edges_truncated", "basis"],
  "properties": {
    "items": {"type": "array", "maxItems": 200, "items": {"$ref": "https://precog.local/contracts/topology.schema.json#/$defs/host"}},
    "total_hosts": {"type": "integer", "minimum": 0},
    "total_edges": {"type": "integer", "minimum": 0},
    "total_matches": {"type": "integer", "minimum": 0},
    "offset": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "next_offset": {"type": ["integer", "null"], "minimum": 0},
    "query": {"type": "string", "maxLength": 120},
    "zone": {"type": ["string", "null"], "maxLength": 80},
    "zones": {"type": "array", "items": {"type": "object", "required": ["zone", "host_count", "normal_count", "compromised_count", "contained_count", "edge_count"], "properties": {
      "zone": {"type": "string"}, "host_count": {"type": "integer", "minimum": 0}, "normal_count": {"type": "integer", "minimum": 0},
      "compromised_count": {"type": "integer", "minimum": 0}, "contained_count": {"type": "integer", "minimum": 0}, "edge_count": {"type": "integer", "minimum": 0}
    }, "additionalProperties": false}},
    "edge_bundles": {"type": "array", "items": {"type": "object", "required": ["from_zone", "to_zone", "count"], "properties": {
      "from_zone": {"type": "string"}, "to_zone": {"type": "string"}, "count": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false}},
    "page_edges": {"type": "array", "maxItems": 1000, "items": {"$ref": "https://precog.local/contracts/topology.schema.json#/$defs/edge"}},
    "page_edges_truncated": {"type": "boolean"},
    "basis": {"type": "string"}
  },
  "additionalProperties": false
}
