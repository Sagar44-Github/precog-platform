{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/reeval_result.schema.json",
  "title": "Re-evaluation result",
  "description": "What happened after a containment.",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "attack_progressed": {
      "type": "boolean"
    },
    "chain_ended_early": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "action_id",
    "attack_progressed",
    "chain_ended_early",
    "summary"
  ],
  "additionalProperties": false
}
