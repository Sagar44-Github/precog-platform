{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/session_record.schema.json",
  "title": "Session record",
  "description": "Everything that happened in one replay session.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 UTC time, for example 2026-10-03T10:00:03Z"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 UTC time or null"
    },
    "forecasts": {
      "type": "array",
      "items": {
        "$ref": "https://precog.local/contracts/forecast.schema.json"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "https://precog.local/contracts/containment_action.schema.json"
      }
    }
  },
  "required": [
    "session_id",
    "scenario_id",
    "started_at",
    "ended_at",
    "forecasts",
    "actions"
  ],
  "additionalProperties": false
}
