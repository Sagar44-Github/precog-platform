{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/workspace_list.schema.json",
  "title": "Dataset workspace list",
  "type": "object",
  "properties": {
    "active_workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "available",
              "installing",
              "unavailable"
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "integer",
                "minimum": 0
              },
              "edges": {
                "type": "integer",
                "minimum": 0
              },
              "events": {
                "type": "integer",
                "minimum": 0
              },
              "labelled_events": {
                "type": "integer",
                "minimum": 0
              },
              "routes": {
                "type": "integer",
                "minimum": 0
              },
              "time_span_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "hosts",
              "edges",
              "events",
              "labelled_events",
              "routes",
              "time_span_ms"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "detection_labels": {
                "type": "string",
                "enum": [
                  "native",
                  "derived",
                  "none"
                ]
              },
              "host_compromise": {
                "type": "string",
                "enum": [
                  "native",
                  "derived",
                  "none"
                ]
              },
              "lateral_movement_routes": {
                "type": "string",
                "enum": [
                  "native",
                  "derived",
                  "none"
                ]
              },
              "topology": {
                "type": "string",
                "enum": [
                  "native",
                  "derived",
                  "none"
                ]
              }
            },
            "required": [
              "detection_labels",
              "host_compromise",
              "lateral_movement_routes",
              "topology"
            ],
            "additionalProperties": false
          },
          "redistribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "status",
          "counts",
          "capabilities",
          "redistribution"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "active_workspace",
    "workspaces"
  ],
  "additionalProperties": false
}
