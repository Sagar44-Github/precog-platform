{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/incident.schema.json",
  "title": "Incident investigation record",
  "type": "object",
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC-[0-9]{4}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["open", "contained", "closed", "reopened"] },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "first_alert_at": { "type": "string", "format": "date-time" },
    "last_alert_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "integer", "minimum": 0 },
    "alert_ids": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "array", "maxItems": 200, "items": { "$ref": "https://precog.local/contracts/security_event.schema.json" } },
    "affected_hosts": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
    "compromised_hosts": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
    "attack_path": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
    "techniques": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "technique_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "tactics": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["technique_id", "name", "tactics"],
        "additionalProperties": false
      }
    },
    "forecast_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "forecasts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "forecast_id": { "type": "string", "minLength": 1 },
          "from_host": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "hit", "miss", "superseded"] },
          "targets": { "type": "array", "maxItems": 3, "items": { "type": "object", "properties": { "rank": { "type": "integer", "minimum": 1, "maximum": 3 }, "host_id": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }, "required": ["rank", "host_id", "confidence"], "additionalProperties": false } },
          "outcome": { "type": ["object", "null"], "properties": { "attempted_host": { "type": "string", "minLength": 1 }, "rank_hit": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 }, "blocked": { "type": "boolean" } }, "required": ["attempted_host", "rank_hit", "blocked"], "additionalProperties": false },
          "ts": { "type": ["string", "null"] }
        },
        "required": ["forecast_id", "from_host", "status", "targets", "outcome", "ts"],
        "additionalProperties": false
      }
    },
    "forecast_outcome": { "type": ["object", "null"], "properties": { "forecast_id": { "type": "string" }, "status": { "type": "string", "enum": ["hit", "miss"] }, "blocked": { "type": "boolean" }, "rank_hit": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 }, "attempted_host": { "type": ["string", "null"] }, "label": { "type": "string" } }, "required": ["forecast_id", "status", "blocked", "rank_hit", "attempted_host", "label"], "additionalProperties": false },
    "action_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "actions": { "type": "array", "maxItems": 100, "items": { "$ref": "https://precog.local/contracts/containment_action.schema.json" } },
    "correlation_reasons": { "type": "array", "maxItems": 200, "items": { "type": "object", "properties": { "event_id": { "type": "string" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }, "required": ["event_id", "reason"], "additionalProperties": false } },
    "notes": { "type": "array", "maxItems": 50, "items": { "$ref": "https://precog.local/contracts/incident_note.schema.json" } },
    "closed_reason": { "type": ["string", "null"], "maxLength": 500 },
    "containment_basis": { "type": ["string", "null"], "maxLength": 500 }
  },
  "required": ["incident_id", "session_id", "scenario_id", "title", "status", "severity", "created_at", "updated_at", "first_alert_at", "last_alert_at", "duration_seconds", "alert_ids", "evidence", "affected_hosts", "compromised_hosts", "attack_path", "techniques", "forecast_ids", "forecasts", "forecast_outcome", "action_ids", "actions", "correlation_reasons", "notes", "closed_reason", "containment_basis"],
  "additionalProperties": false
}
