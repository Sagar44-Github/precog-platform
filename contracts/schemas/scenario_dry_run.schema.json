{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/scenario_dry_run.schema.json",
  "title": "Scenario dry-run estimate",
  "type": "object",
  "required": ["scenario_id", "event_count", "duration_ms", "host_states", "forecasts", "basis"],
  "properties": {
    "scenario_id": {"type": "string"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 7200000},
    "host_states": {"type": "object", "additionalProperties": {"type": "string", "enum": ["normal", "compromised", "contained"]}},
    "forecasts": {"type": "array", "items": {"type": "object", "required": ["from_host", "targets", "outcome"], "properties": {"from_host": {"type": "string"}, "targets": {"type": "array", "items": {"type": "object", "required": ["rank", "host_id", "confidence"], "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 3}, "host_id": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}}, "outcome": {"type": ["object", "null"]}}, "additionalProperties": false}},
    "basis": {"type": "string", "minLength": 1, "maxLength": 300}
  },
  "additionalProperties": false
}
