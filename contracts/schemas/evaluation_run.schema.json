{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/evaluation_run.schema.json",
  "title": "Precog held-out evaluation run",
  "type": "object",
  "required": ["experiment_id", "created_at", "parameters", "result", "runtime_ms", "cached"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{6}$"}, "created_at": {"type": "string"},
    "parameters": {"type": "object", "required": ["seed", "test_fraction", "alpha_grid"], "properties": {"seed": {"type": "integer"}, "test_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.5}, "alpha_grid": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "number", "minimum": 0.001, "maximum": 2}}}, "additionalProperties": false},
    "result": {"type": "object", "required": ["node_model", "baseline_rule_based", "baseline_uniform", "split", "alpha"], "additionalProperties": true},
    "runtime_ms": {"type": "integer", "minimum": 0}, "cached": {"type": "boolean"}
  },
  "additionalProperties": false
}
