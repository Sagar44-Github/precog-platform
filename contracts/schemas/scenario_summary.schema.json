{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/scenario_summary.schema.json",
  "title": "Replay scenario summary",
  "type": "object",
  "required": ["scenario_id", "description", "events", "has_decision_point", "source", "editable"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string"},
    "events": {"type": "integer", "minimum": 1, "maximum": 200},
    "has_decision_point": {"type": "boolean"},
    "source": {"type": "string", "enum": ["shipped", "user"]},
    "editable": {"type": "boolean"}
  },
  "additionalProperties": false
}
