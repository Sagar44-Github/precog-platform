{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/forecast.schema.json",
  "title": "Forecast",
  "description": "Precog's prediction of the attacker's next hosts.",
  "type": "object",
  "properties": {
    "forecast_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 UTC time, for example 2026-10-03T10:00:03Z"
    },
    "from_host": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "host_id",
          "confidence"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "technique_hint": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "technique_id",
        "technique_name",
        "probability"
      ],
      "properties": {
        "technique_id": {
          "type": "string",
          "minLength": 1
        },
        "technique_name": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "repo",
        "lookup"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "hit",
        "miss",
        "superseded"
      ]
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "attempted_host",
        "rank_hit",
        "blocked"
      ],
      "properties": {
        "attempted_host": {
          "type": "string",
          "minLength": 1
        },
        "rank_hit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        },
        "blocked": {
          "type": "boolean"
        }
      }
    },
    "explanation": {
      "type": "object",
      "description": "Compact generation-time evidence; the full forecast explanation has its own endpoint and contract.",
      "required": [
        "model",
        "technique_hint_source",
        "candidate_count",
        "candidate_set"
      ],
      "properties": {
        "model": {
          "type": "object",
          "required": [
            "name",
            "alpha"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "alpha": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "technique_hint_source": {
          "enum": [
            "repo",
            "lookup"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_set": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host_id",
              "transition_count",
              "model_probability",
              "model_rank",
              "rule_based_probability",
              "rule_based_rank",
              "uniform_probability",
              "uniform_rank"
            ],
            "properties": {
              "host_id": {
                "type": "string",
                "minLength": 1
              },
              "transition_count": {
                "type": "integer",
                "minimum": 0
              },
              "model_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "model_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "rule_based_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rule_based_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "uniform_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uniform_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "forecast_id",
    "ts",
    "from_host",
    "targets",
    "technique_hint",
    "source",
    "status",
    "outcome"
  ],
  "additionalProperties": false
}
