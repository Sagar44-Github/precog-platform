{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/snapshot_index.schema.json",
  "title": "Replay snapshot index",
  "type": "object",
  "required": ["run_id", "items"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "items": {"type": "array", "maxItems": 2000, "items": {"type": "object", "required": ["version", "position", "event_seq", "event_kind", "captured_at"], "properties": {"version": {"type": "integer", "minimum": 0}, "position": {"type": "integer", "minimum": 0}, "event_seq": {"type": ["integer", "null"]}, "event_kind": {"type": "string"}, "captured_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
