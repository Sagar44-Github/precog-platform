{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/what_if_forecast.schema.json",
  "title": "What-if forecast",
  "description": "A read-only forecast preview for a currently compromised host; it never changes live replay state.",
  "type": "object",
  "properties": {
    "from_host": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "rank",
          "host_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "technique_hint": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "technique_id": {
          "type": "string",
          "minLength": 1
        },
        "technique_name": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "technique_id",
        "technique_name",
        "probability"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "enum": [
        "repo",
        "lookup"
      ]
    },
    "explanation": {
      "type": "object",
      "description": "Compact generation-time evidence; the full forecast explanation has its own endpoint and contract.",
      "required": [
        "model",
        "technique_hint_source",
        "candidate_count",
        "candidate_set"
      ],
      "properties": {
        "model": {
          "type": "object",
          "required": [
            "name",
            "alpha"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "alpha": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "technique_hint_source": {
          "enum": [
            "repo",
            "lookup"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_set": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host_id",
              "transition_count",
              "model_probability",
              "model_rank",
              "rule_based_probability",
              "rule_based_rank",
              "uniform_probability",
              "uniform_rank"
            ],
            "properties": {
              "host_id": {
                "type": "string",
                "minLength": 1
              },
              "transition_count": {
                "type": "integer",
                "minimum": 0
              },
              "model_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "model_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "rule_based_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rule_based_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "uniform_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "uniform_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "from_host",
    "generated_at",
    "targets",
    "technique_hint",
    "source",
    "explanation",
    "note"
  ],
  "additionalProperties": false
}
