{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precog.local/contracts/audit_entry.schema.json",
  "title": "Audit entry",
  "description": "One line of the audit log.",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 UTC time, for example 2026-10-03T10:00:03Z"
    },
    "type": {
      "type": "string",
      "enum": [
        "detection",
        "forecast",
        "containment"
      ]
    },
    "ref_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "ts",
    "type",
    "ref_id",
    "summary"
  ],
  "additionalProperties": false
}
