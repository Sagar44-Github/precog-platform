# HOW TO USE THIS FILE
# 1. Copy this file and name the copy ".env" (same folder). The ".env" file is never committed.
# 2. Fill in SECRET_KEY and ADMIN_PASSWORD. Leave the other lines as they are.

# A long random text. Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The password for the demo account (username: admin). At least 8 characters. Do not reuse a real password.
ADMIN_PASSWORD=

# Optional role-demo accounts, created on startup when configured.
# Use username "analyst" for analyst access and "viewer" for read-only access.
# Viewer can neither contain hosts nor control replay. Analyst can contain and run replay.
# Only admin can release containment or restart a replay.
ANALYST_PASSWORD=
VIEWER_PASSWORD=

# Optional path for validated, locally authored replay scenarios. Defaults to lead-core/backend/data/scenarios.
CUSTOM_SCENARIOS_DIR=

# Leave empty to use the built-in SQLite database file. Only change this if the build guide tells you to.
DATABASE_URL=

# "sample" = the web app shows fake sample data (works before the real pipeline exists).
# "live"   = the real pipeline runs (used later, in Part 2 and by the other roles).
DATA_MODE=sample

# Where the backend listens on your own laptop.
HOST=127.0.0.1
PORT=5000

# Set to 1 only when the app is hosted on https:// (it makes the login cookie HTTPS-only).
COOKIE_SECURE=0

# 1 = train NIDS's detector model automatically on first start (about 10 seconds).
AUTO_TRAIN_MODEL=1

# 1 = check every piece of data against its contract. Keep at 1 while building.
VALIDATE_CONTRACTS=1

# Which technique table Precog prefers: repo (exported from the forecasting repository) or lookup (the hand-written rule table).
FORECAST_SOURCE=repo
